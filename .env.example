# LedgerLens Environment Configuration Example
# Copy this file to .env and insert your real Groq API key for live AI inference

# Groq API Key for live bounded AI matching assistance (Optional; defaults to REVIEW if missing)
GROQ_API_KEY=gsk_YOUR_GROQ_API_KEY_HERE

# Groq Rate Limiter (maximum requests per minute, defaults to 25 to respect free tier RPM)
GROQ_MAX_CALLS_PER_MINUTE=25

# API & Reconciliation Debug Observability Mode (true / false)
LEDGERLENS_DEBUG_MODE=false

# Custom Operational Data Input Directory
LEDGERLENS_CUSTOM_DATA_DIR=data/custom
